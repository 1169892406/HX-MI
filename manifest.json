{
  "schema_version": 2,
  "plugin_id": "homex.xiaomi_miot",
  "name": "HX-MI",
  "version": "2.0.0-alpha.190",
  "publisher": {
    "id": "hx-community",
    "display_name": "HX Community",
    "homepage": "https://homex.dev"
  },
  "type": "device_driver",
  "runtime": "wasm",
  "api_version": "2",
  "scope": "household",
  "description": "接入小米米家设备：多账号登录与 Token 自动续期（过期自动重登）、云端设备同步、局域网直连控制、设备健康巡检、红外遥控学习与下发。",
  "permissions": [
    "config.read",
    "network.outbound",
    "network.datagram",
    "network.mqtt",
    "driver.register",
    "secret.read",
    "storage.read",
    "storage.write",
    "schedule.create",
    "migration.read",
    "cookie.ticket",
    "secret.blob",
    "migration.device_secret"
  ],
  "entry": {
    "wasm": "plugin.wasm",
    "ui": "ui/index.html"
  },
  "provides": {
    "tools": [
      {
        "name": "regions",
        "risk": "low"
      },
      {
        "name": "login",
        "risk": "high"
      },
      {
        "name": "captcha",
        "risk": "medium"
      },
      {
        "name": "captcha_image",
        "risk": "low"
      },
      {
        "name": "verify",
        "risk": "high"
      },
      {
        "name": "verify_web",
        "risk": "high"
      },
      {
        "name": "status",
        "risk": "low"
      },
      {
        "name": "logout",
        "risk": "medium"
      },
      {
        "name": "account",
        "risk": "low"
      },
      {
        "name": "settings",
        "risk": "medium"
      },
      {
        "name": "sync_now",
        "risk": "medium"
      },
      {
        "name": "accounts",
        "risk": "low"
      },
      {
        "name": "account_settings",
        "risk": "medium",
        "scope": "account"
      },
      {
        "name": "account_sync",
        "risk": "medium"
      },
      {
        "name": "account_delete",
        "risk": "high",
        "scope": "account"
      },
      {
        "name": "catalog_status",
        "risk": "low"
      },
      {
        "name": "catalog_refresh",
        "risk": "medium"
      },
      {
        "name": "lan_health",
        "risk": "low"
      },
      {
        "name": "lan_diagnose",
        "risk": "low"
      },
      {
        "name": "ir_probe",
        "risk": "low"
      },
      {
        "name": "cred_check",
        "risk": "low"
      },
      {
        "name": "ir_lib",
        "risk": "low"
      },
      {
        "name": "ir_send",
        "risk": "medium"
      },
      {
        "name": "ir_raw",
        "risk": "medium"
      },
      {
        "name": "ir_learn",
        "risk": "medium"
      },
      {
        "name": "ir_read",
        "risk": "low"
      },
      {
        "name": "health_list",
        "risk": "low"
      },
      {
        "name": "device_info",
        "risk": "low"
      },
      {
        "name": "device_detail",
        "risk": "low"
      },
      {
        "name": "qr_start",
        "risk": "high"
      },
      {
        "name": "qr_status",
        "risk": "low"
      },
      {
        "name": "qr_cancel",
        "risk": "low"
      },
      {
        "name": "qr_svg",
        "risk": "low"
      },
      {
        "name": "device_switch",
        "risk": "medium"
      },
      {
        "name": "device_control",
        "risk": "medium"
      }
    ],
    "drivers": [
      {
        "name": "xiaomi_miot",
        "capabilities": [
          "sensor",
          "switch",
          "light",
          "climate",
          "cover"
        ],
        "discovery": true
      }
    ],
    "background": true
  },
  "resources": {
    "udp": {
      "ports": [
        54321
      ],
      "max_payload_bytes": 4096,
      "rate_per_second": 20
    },
    "mqtt": {
      "topics": [
        "homex/{hh}/"
      ],
      "qos": 1,
      "retain": true
    },
    "filesystem": {
      "quota_kb": 4096,
      "max_file_kb": 1024
    },
    "background": {
      "max_tasks": 8,
      "min_interval_ms": 200
    },
    "http": {
      "allowed_hosts": [
        "account.xiaomi.com",
        "*.account.xiaomi.com",
        "cn.account.xiaomi.com",
        "sts.api.io.mi.com",
        "api.io.mi.com"
      ],
      "cookie_exports": [
        {
          "host": "account.xiaomi.com",
          "names": [
            "passToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_account"
        },
        {
          "host": "sts.api.io.mi.com",
          "names": [
            "serviceToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_service"
        },
        {
          "host": "api.io.mi.com",
          "names": [
            "serviceToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_service"
        }
      ]
    },
    "migrations": [
      {
        "name": "hx_mi_legacy",
        "secret_keys": [
          "miio_token"
        ]
      }
    ],
    "secrets": {
      "blobs": [
        {
          "key": "xiaomi_session_material",
          "max_bytes": 4096,
          "scope": "household",
          "rotatable": true
        },
        {
          "key": "miio_token",
          "max_bytes": 64,
          "scope": "device",
          "rotatable": true
        },
        {
          "key": "accounts_key_material",
          "max_bytes": 128,
          "scope": "household",
          "rotatable": false
        },
        {
          "key": "account_password",
          "max_bytes": 512,
          "scope": "household",
          "rotatable": true
        }
      ]
    }
  },
  "secrets": [
    {
      "key": "accounts_master_key",
      "required": true,
      "rotate": false,
      "description": "HX-MI 账号与 vault 主密钥"
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "region": {
        "type": "string",
        "default": "cn",
        "title": "区域",
        "description": "小米账号所在区域；选项由插件的 regions 工具提供。",
        "x-options-from": "regions"
      },
      "sync_interval_seconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 3600,
        "default": 300,
        "title": "同步间隔（秒）",
        "description": "后台拉取云端设备列表的间隔。数字带上下界 ⇒ 平台渲染为滑块。"
      },
      "polling_enabled": {
        "type": "boolean",
        "default": true,
        "title": "自动同步",
        "description": "关闭后不再后台轮询云端设备列表（手动同步仍可用）。"
      },
      "device_filter_models": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "title": "设备型号过滤",
        "description": "非空时只同步 model 以这些前缀开头的设备；留空同步全部。逗号分隔。"
      },
      "save_password": {
        "type": "boolean",
        "default": false,
        "title": "保存账号密码（自动重登）",
        "description": "小米登录票据约 11 小时失效，届时云端同步/控制都会失败。开启后插件用保存的密码自动重登，免去反复手动登录。密码保存在平台保险库（加密），关闭本项会立即删除。⚠ 开启等于把账号托付给插件，请自行权衡。"
      },
      "lan_priority": {
        "type": "string",
        "enum": [
          "lan",
          "cloud"
        ],
        "default": "lan",
        "title": "命令优先通道",
        "description": "lan = 局域网优先（默认，响应更快、不依赖登录）；cloud = 云端优先（局域网不通时更可靠）。另一条通道可用时会自动回退。"
      },
      "lan_check_interval_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 3600,
        "default": 5,
        "title": "离线检查间隔（秒）",
        "description": "局域网健康检查默认开启（无开关），定时发 UDP 探测包（无副作用）。单台探测超时 3 秒，上次未返回则跳过本轮不堆叠。范围 5~3600。"
      }
    }
  },
  "limits": {
    "max_memory_mb": 256,
    "execution_timeout_ms": 30000,
    "max_storage_kb": 4096
  },
  "signature": {
    "algorithm": "ed25519",
    "key_id": "hx-mi-community",
    "value": ""
  },
  "changelog": "传感器温度统一写 temperature 属性（老协议路径原先写 value）。平台状态库按属性名合并、从不删旧键，键名不一致会让同一个温度在库里留下两个键，界面出现「温度 37 / 数值 40」两条、其中一条是两天前的残留。规格化与云端 BLE 路径同样带 unit=℃ 并正名 temperature（云端仅用于无局域网 IP 的 BLE 传感器）。",
  "tools": [
    "regions",
    "login",
    "captcha",
    "captcha_image",
    "verify",
    "verify_web",
    "status",
    "logout",
    "account",
    "settings",
    "sync_now",
    "accounts",
    "account_settings",
    "account_sync",
    "account_delete",
    "catalog_status",
    "catalog_refresh",
    "lan_health",
    "qr_start",
    "qr_status",
    "qr_cancel",
    "qr_svg"
  ]
}
