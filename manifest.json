{
  "schema_version": 2,
  "plugin_id": "homex.xiaomi_miot",
  "name": "HX-MI",
  "version": "2.0.0-alpha.63",
  "publisher": {
    "id": "homex",
    "display_name": "HOMEX Official",
    "homepage": "https://homex.dev"
  },
  "type": "device_driver",
  "runtime": "wasm",
  "api_version": "2",
  "scope": "household",
  "description": "由 8090 插件宿主加载的 HX-MI ABI v2 迁移候选；不监听独立端口。",
  "permissions": [
    "config.read",
    "network.outbound",
    "network.datagram",
    "network.mqtt",
    "driver.register",
    "secret.read",
    "storage.read",
    "storage.write",
    "schedule.create",
    "migration.read",
    "cookie.ticket",
    "secret.blob",
    "migration.device_secret"
  ],
  "entry": {
    "wasm": "plugin.wasm",
    "ui": "ui/index.html"
  },
  "provides": {
    "tools": [
      {
        "name": "regions",
        "risk": "low"
      },
      {
        "name": "login",
        "risk": "high"
      },
      {
        "name": "captcha",
        "risk": "medium"
      },
      {
        "name": "captcha_image",
        "risk": "low"
      },
      {
        "name": "verify",
        "risk": "high"
      },
      {
        "name": "verify_web",
        "risk": "high"
      },
      {
        "name": "status",
        "risk": "low"
      },
      {
        "name": "logout",
        "risk": "medium"
      },
      {
        "name": "account",
        "risk": "low"
      },
      {
        "name": "settings",
        "risk": "medium"
      },
      {
        "name": "sync_now",
        "risk": "medium"
      },
      {
        "name": "accounts",
        "risk": "low"
      },
      {
        "name": "account_settings",
        "risk": "medium",
        "scope": "account"
      },
      {
        "name": "account_sync",
        "risk": "medium",
        "scope": "account"
      },
      {
        "name": "account_delete",
        "risk": "high",
        "scope": "account"
      },
      {
        "name": "catalog_status",
        "risk": "low"
      },
      {
        "name": "catalog_refresh",
        "risk": "medium"
      },
      {
        "name": "lan_health",
        "risk": "low"
      }
    ],
    "drivers": [
      {
        "name": "xiaomi_miot",
        "capabilities": [
          "sensor",
          "switch",
          "light",
          "climate",
          "cover"
        ],
        "discovery": true
      }
    ],
    "background": true
  },
  "resources": {
    "udp": {
      "ports": [
        54321
      ],
      "max_payload_bytes": 4096,
      "rate_per_second": 20
    },
    "mqtt": {
      "topics": [
        "homex/{hh}/"
      ],
      "qos": 1,
      "retain": true
    },
    "filesystem": {
      "quota_kb": 4096,
      "max_file_kb": 1024
    },
    "background": {
      "max_tasks": 8,
      "min_interval_ms": 200
    },
    "http": {
      "allowed_hosts": [
        "account.xiaomi.com",
        "cn.account.xiaomi.com",
        "sts.api.io.mi.com",
        "api.io.mi.com"
      ],
      "cookie_exports": [
        {
          "host": "account.xiaomi.com",
          "names": [
            "passToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_account"
        },
        {
          "host": "sts.api.io.mi.com",
          "names": [
            "serviceToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_service"
        },
        {
          "host": "api.io.mi.com",
          "names": [
            "serviceToken",
            "userId",
            "cUserId"
          ],
          "secret_key": "xiaomi_service"
        }
      ]
    },
    "migrations": [
      {
        "name": "hx_mi_legacy",
        "secret_keys": [
          "miio_token"
        ]
      }
    ],
    "secrets": {
      "blobs": [
        {
          "key": "xiaomi_session_material",
          "max_bytes": 4096,
          "scope": "household",
          "rotatable": true
        },
        {
          "key": "miio_token",
          "max_bytes": 64,
          "scope": "device",
          "rotatable": true
        }
      ]
    }
  },
  "secrets": [
    {
      "key": "accounts_master_key",
      "required": true,
      "rotate": false,
      "description": "HX-MI 账号与 vault 主密钥"
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "region": {
        "type": "string",
        "default": "cn",
        "title": "区域",
        "description": "小米账号所在区域；选项由插件的 regions 工具提供。",
        "x-options-from": "regions"
      },
      "sync_interval_seconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 3600,
        "default": 300,
        "title": "同步间隔（秒）",
        "description": "后台拉取云端设备列表的间隔。数字带上下界 ⇒ 平台渲染为滑块。"
      },
      "polling_enabled": {
        "type": "boolean",
        "default": true,
        "title": "自动同步",
        "description": "关闭后不再后台轮询云端设备列表（手动同步仍可用）。"
      },
      "device_filter_models": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "title": "设备型号过滤",
        "description": "非空时只同步 model 以这些前缀开头的设备；留空同步全部。逗号分隔。"
      }
    }
  },
  "limits": {
    "max_memory_mb": 128,
    "execution_timeout_ms": 30000,
    "max_storage_kb": 4096
  },
  "signature": {
    "algorithm": "ed25519",
    "key_id": "hx-mi-community",
    "value": ""
  },
  "changelog": "2.0.0-alpha.63：修**「删除」等三个按钮点了没反应**。真因：插件界面跑在 sandbox=\"allow-scripts\" 的 iframe 里，**没有 allow-modals** —— 规范规定这种情形下 window.confirm() 不弹窗、直接返回 false。于是三处「先确认再执行」的按钮全哑，而且**没有任何报错**（代码逻辑上等于\"用户点了取消\"）：删除同步条目 / 删除账号 / 退出登录。改为页面内确认框（overlay + 卡片），并加闸门：源码（剥注释后）不得出现 window.confirm/alert/prompt；再逐个点一遍所有按钮断言有反应（共 21 项）。顺带把行内「删除」按钮加上边框（原来太淡）。",
  "tools": [
    "regions",
    "login",
    "captcha",
    "captcha_image",
    "verify",
    "verify_web",
    "status",
    "logout",
    "account",
    "settings",
    "sync_now",
    "accounts",
    "account_settings",
    "account_sync",
    "account_delete",
    "catalog_status",
    "catalog_refresh",
    "lan_health"
  ]
}
